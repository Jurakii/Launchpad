// Pieces of the taskbar (taskbar.slint): item icons, the pinned and
// open-window tiles, the popout rows. Sizes from renderer/styles.css.
import { Theme } from "theme.slint";

export struct TaskbarItem {
    id: string,
    name: string,
    // The island it's in ("Home", "Work / Tools"): search and Recent rows.
    path: string,
    // "image", "island", "stored-folder", "recycle" or "placeholder" (iconNode in renderer.js).
    kind: string,
    icon: image,
    color: color,
    app: bool,
    stored: bool,
}

export struct TaskbarWindow {
    title: string,
    icon: image,
    has-icon: bool,
    // .window-tile-fallback: the title's first letter.
    letter: string,
}

// iconNode(): the item's icon, or the glyph 1.2 drew for it.
export component ItemIcon inherits Rectangle {
    in property <TaskbarItem> item;
    if item.kind == "image": Image {
        source: item.icon;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }
    if item.kind == "island": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: item.color;
        commands: "M3 6.5A2.5 2.5 0 0 1 5.5 4h4l2 2h7A2.5 2.5 0 0 1 21 8.5v9A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5v-11Z";
    }
    if item.kind == "stored-folder": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: #d9a425;
        commands: "M2.5 6A2 2 0 0 1 4.5 4h4.2l2 2h8.8a2 2 0 0 1 2 2v1H2.5V6Z";
    }
    if item.kind == "stored-folder": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: #f6c94b;
        commands: "M2 9.2A1.2 1.2 0 0 1 3.2 8h17.6A1.2 1.2 0 0 1 22 9.2l-.8 9A2 2 0 0 1 19.2 20H4.8a2 2 0 0 1-2-1.8l-.8-9Z";
    }
    if item.kind == "recycle": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: Theme.text;
        commands: "M17,4V5H15V4H9V5H7V4A2,2,0,0,1,9,2h6A2,2,0,0,1,17,4Z M20,6H4A1,1,0,0,0,4,8H5V20a2,2,0,0,0,2,2H17a2,2,0,0,0,2-2V8h1a1,1,0,0,0,0-2ZM11,17a1,1,0,0,1-2,0V11a1,1,0,0,1,2,0Zm4,0a1,1,0,0,1-2,0V11a1,1,0,0,1,2,0Z";
    }
    // PLACEHOLDER_ICON
    if item.kind == "placeholder": Rectangle {
        background: #2b2f38;
        border-radius: parent.width * 10 / 48;
        Text {
            text: "?";
            color: #9aa0ac;
            font-size: parent.height * 20 / 48;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// renderer/icons/recent.svg and the side bar's search magnifier (styles.css).
export component Glyph inherits Path {
    in property <string> name;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: Theme.accent;
    stroke-width: self.width * (name == "search" ? 2.4 : 1.8) / 24;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: name == "search"
        ? "M4 10.5A6.5 6.5 0 1 0 17 10.5A6.5 6.5 0 1 0 4 10.5Z M15.5 15.5L21 21"
        : "M4.3 12a7.7 7.7 0 1 0 2.4-5.6 M3.8 4v4.2h4.2 M12 8.3v4.4l3 1.8";
}

// .pin-tile / .window-tile: 40px, 8px corners, --bg on hover.
export component Tile inherits Rectangle {
    in property <string> tip;
    out property <bool> hovered: ta.has-hover;
    callback press(PointerEvent, length, length);
    callback moved(length, length);
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.bg : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => { root.press(e, self.mouse-x, self.mouse-y); }
        moved => { root.moved(self.mouse-x, self.mouse-y); }
        clicked => { root.clicked(); }
    }
    // Above the touch area, so a tile's own menu gets its right-click.
    @children
    if tip != "": Tooltip { text: @markdown("\{root.tip}"); }
}

// A search / Recent row (.search-result).
export component ResultRow inherits Rectangle {
    in property <TaskbarItem> item;
    in property <bool> current;
    callback chosen();
    height: 44px;
    border-radius: 8px;
    background: ta.has-hover || current ? Theme.bg : transparent;
    HorizontalLayout {
        padding: 8px;
        spacing: 10px;
        ItemIcon {
            item: root.item;
            width: 28px;
            height: 28px;
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.item.name; color: Theme.text; font-size: 13px; overflow: elide; }
            Text { text: root.item.path; color: Theme.muted; font-size: 11px; overflow: elide; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }
}

// .search-results: the panel both popouts share.
export component ResultPanel inherits Rectangle {
    in property <[TaskbarItem]> items;
    in property <string> empty-text;
    in property <int> current: -1;
    callback chosen(TaskbarItem);
    property <length> list-height: items.length == 0 ? 38px : items.length * 44px;
    width: 320px;
    height: min(360px, list-height + 14px);
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 10px;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000066;
    if items.length == 0: Text {
        x: 7px;
        y: 7px;
        width: parent.width - 14px;
        text: root.empty-text;
        color: Theme.muted;
        font-size: 13px;
        // .search-empty's 10px padding
        height: 38px;
        vertical-alignment: center;
        horizontal-alignment: left;
    }
    flick := Flickable {
        x: 7px;
        y: 7px;
        width: parent.width - 14px;
        height: parent.height - 14px;
        content-height: root.items.length * 44px;
        for item[i] in root.items: ResultRow {
            y: i * 44px;
            width: parent.width;
            item: item;
            current: i == root.current;
            chosen => { root.chosen(item); }
        }
    }
    // Keeps the keyboard's row in view.
    changed current => {
        if current >= 0 {
            if current * 44px < -flick.content-y {
                flick.content-y = -current * 44px;
            } else if (current + 1) * 44px > -flick.content-y + flick.height {
                flick.content-y = flick.height - (current + 1) * 44px;
            }
        }
    }
}
