// Every modal over the main window: add/edit item, name + colour, move to
// island, alert and confirm. Rust side: src/ui/modals.rs, which keeps all
// of their state (the window is dropped on hide) and pushes it in here.
import { Theme } from "theme.slint";
import { ComboBox, TextEdit, LineEdit, ScrollView, Palette } from "std-widgets.slint";
import { LpButton, Overlay, Heading, Caption, Field } from "modals-widgets.slint";

export struct MoveRow {
    label: string,
    current: bool,
}

export global ModalState {
    // Alert / confirm: the front of Rust's queue.
    in property <bool> dialog-open;
    in property <string> dialog-message;
    in property <bool> dialog-cancel;
    in property <string> dialog-ok-label: "OK";
    in property <bool> dialog-danger;
    callback dialog-done(bool);

    // Add / Edit App. The fields are two-way here and also reported to Rust
    // as they change (`app-field`), so a hide and show keeps them.
    in property <bool> app-open;
    in property <string> app-title;
    in property <bool> app-editing;
    in property <bool> app-stored;
    in property <image> app-icon;
    in property <bool> app-has-icon;
    in-out property <string> f-name;
    // 0 path, 1 url, 2 script, 3 command (the Type select's order).
    in-out property <int> f-type;
    in-out property <string> f-target;
    in-out property <string> f-url;
    in-out property <string> f-interpreter;
    in-out property <string> f-args;
    in-out property <string> f-cwd-script;
    in-out property <string> f-command;
    in-out property <string> f-cwd-command;
    callback app-field(string, string);
    callback browse(bool);
    callback choose-icon();
    in property <bool> icon-search-open;
    in-out property <string> icon-query;
    in property <[image]> icon-hits;
    in property <string> icon-status;
    callback icon-search(string);
    callback icon-search-close();
    callback icon-pick(int);
    callback auto-icon();
    callback app-remove();
    callback app-save();
    callback app-cancel();

    // New Island / Rename.
    in property <bool> name-open;
    in property <string> name-title;
    in-out property <string> name-text;
    in property <bool> name-colors;
    in property <[color]> swatches;
    // Index into `swatches`, or -1: the custom colour `name-custom` is chosen.
    in property <int> name-selected;
    in property <color> name-custom;
    in-out property <string> name-hex;
    in property <bool> name-hex-open;
    callback name-field(string);
    callback name-pick(int);
    callback name-custom-clicked();
    callback name-hex-edited(string);
    callback name-save();
    callback name-cancel();

    // Move to Island.
    in property <bool> move-open;
    in property <[MoveRow]> move-rows;
    callback move-pick(int);
    callback move-cancel();

    // Rust bumps it after a modal closes, to put the keyboard focus back on
    // whatever is now on top.
    in property <int> focus-tick;

    out property <bool> any-open: dialog-open || app-open || name-open || move-open;
}

component AppModal inherits FocusScope {
    key-pressed(e) => {
        if e.text == Key.Escape {
            ModalState.app-cancel();
            return accept;
        }
        reject
    }
    property <int> tick: ModalState.focus-tick;
    changed tick => { if !ModalState.dialog-open { name.focus-field(); } }
    init => { name.focus-field(); }

    Overlay {
        card-width: 420px;
        backdrop-clicked => { ModalState.app-cancel(); }
        sv := ScrollView {
            // The card is at most 86% of the window; the form scrolls inside it.
            preferred-height: form.preferred-height;
            content-height: form.preferred-height;
            content-width: self.visible-width;
            form := VerticalLayout {
                width: sv.visible-width;
                spacing: 12px;
                Heading { text: ModalState.app-title; }
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 8px;
                        if ModalState.app-has-icon: Image {
                            x: 5px;
                            y: 5px;
                            width: 46px;
                            height: 46px;
                            source: ModalState.app-icon;
                            image-fit: contain;
                        }
                        // PLACEHOLDER_ICON: a rounded square with a "?".
                        if !ModalState.app-has-icon: Rectangle {
                            x: 5px;
                            y: 5px;
                            width: 46px;
                            height: 46px;
                            border-radius: 10px;
                            background: #2b2f38;
                            Text {
                                text: "?";
                                font-size: 19px;
                                color: #9aa0ac;
                            }
                        }
                    }
                    if !ModalState.app-stored: VerticalLayout {
                        spacing: 6px;
                        alignment: center;
                        LpButton {
                            text: "Choose Icon…";
                            clicked => { ModalState.choose-icon(); }
                        }
                        LpButton {
                            text: "Auto-detect Icon";
                            clicked => { ModalState.auto-icon(); }
                        }
                        LpButton {
                            text: "Search Icons…";
                            primary: !ModalState.app-has-icon;
                            clicked => { ModalState.icon-search(ModalState.f-name); }
                        }
                    }
                }
                // Search Icons…: online pictures for the name, or other words.
                if ModalState.icon-search-open: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: "Search for an icon";
                            text <=> ModalState.icon-query;
                            accepted(t) => { ModalState.icon-search(t); }
                        }
                        LpButton {
                            text: "Search";
                            clicked => { ModalState.icon-search(ModalState.icon-query); }
                        }
                        LpButton {
                            text: "Close";
                            clicked => { ModalState.icon-search-close(); }
                        }
                    }
                    if ModalState.icon-status != "": Caption { text: ModalState.icon-status; }
                    Rectangle {
                        property <int> per-row: max(1, floor((self.width + 8px) / 64px));
                        height: ceil(ModalState.icon-hits.length / per-row) * 64px;
                        for img[i] in ModalState.icon-hits: Rectangle {
                            x: mod(i, per-row) * 64px;
                            y: floor(i / per-row) * 64px;
                            width: 56px;
                            height: 56px;
                            border-radius: 8px;
                            background: ta.has-hover ? Theme.panel : Theme.bg;
                            border-width: 1px;
                            border-color: ta.has-hover ? Theme.accent : Theme.border;
                            Image {
                                x: 6px;
                                y: 6px;
                                width: 44px;
                                height: 44px;
                                source: img;
                                image-fit: contain;
                            }
                            ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { ModalState.icon-pick(i); }
                            }
                        }
                    }
                }
                name := Field {
                    label: "Name";
                    text <=> ModalState.f-name;
                    edited(t) => { ModalState.app-field("name", t); }
                    accepted => { ModalState.app-save(); }
                }
                if !ModalState.app-stored: VerticalLayout {
                    spacing: 4px;
                    Caption { text: "Type"; }
                    ComboBox {
                        model: ["App / Shortcut / Windows Folder", "Website", "Script (Python, Node, …)", "Custom Command"];
                        current-index <=> ModalState.f-type;
                        selected => { ModalState.app-field("type", self.current-index); }
                    }
                }
                // The path gets the whole width; its buttons go underneath.
                if !ModalState.app-stored && (ModalState.f-type == 0 || ModalState.f-type == 2): VerticalLayout {
                    spacing: 6px;
                    Field {
                        label: ModalState.f-type == 2 ? "Script File" : "Target";
                        placeholder: "C:\\path\\to\\app.exe";
                        text <=> ModalState.f-target;
                        edited(t) => { ModalState.app-field("target", t); }
                        accepted => { ModalState.app-save(); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        LpButton {
                            text: "Browse File…";
                            clicked => { ModalState.browse(false); }
                        }
                        if ModalState.f-type == 0: LpButton {
                            text: "Windows Folder…";
                            clicked => { ModalState.browse(true); }
                        }
                    }
                }
                if !ModalState.app-stored && ModalState.f-type == 1: Field {
                    label: "URL";
                    placeholder: "https://example.com";
                    text <=> ModalState.f-url;
                    edited(t) => { ModalState.app-field("url", t); }
                    accepted => { ModalState.app-save(); }
                }
                if !ModalState.app-stored && ModalState.f-type == 2: VerticalLayout {
                    spacing: 12px;
                    Field {
                        label: "Interpreter";
                        placeholder: "python";
                        text <=> ModalState.f-interpreter;
                        edited(t) => { ModalState.app-field("interpreter", t); }
                        accepted => { ModalState.app-save(); }
                    }
                    Field {
                        label: "Arguments";
                        placeholder: "(optional)";
                        text <=> ModalState.f-args;
                        edited(t) => { ModalState.app-field("args", t); }
                        accepted => { ModalState.app-save(); }
                    }
                    Field {
                        label: "Working Directory";
                        placeholder: "(optional)";
                        text <=> ModalState.f-cwd-script;
                        edited(t) => { ModalState.app-field("cwd-script", t); }
                        accepted => { ModalState.app-save(); }
                    }
                }
                if !ModalState.app-stored && ModalState.f-type == 3: VerticalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px;
                        Caption { text: "Command"; }
                        TextEdit {
                            height: 64px;
                            placeholder-text: "e.g. npm start";
                            text <=> ModalState.f-command;
                            edited(t) => { ModalState.app-field("command", t); }
                        }
                    }
                    Field {
                        label: "Working Directory";
                        placeholder: "C:\\path\\to\\project";
                        text <=> ModalState.f-cwd-command;
                        edited(t) => { ModalState.app-field("cwd-command", t); }
                        accepted => { ModalState.app-save(); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    padding-top: 6px;
                    if ModalState.app-editing: LpButton {
                        text: "Remove";
                        danger: true;
                        clicked => { ModalState.app-remove(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    LpButton {
                        text: "Cancel";
                        clicked => { ModalState.app-cancel(); }
                    }
                    LpButton {
                        text: "Save";
                        primary: true;
                        clicked => { ModalState.app-save(); }
                    }
                }
            }
        }
    }
}

component NameModal inherits FocusScope {
    key-pressed(e) => {
        if e.text == Key.Escape {
            ModalState.name-cancel();
            return accept;
        }
        reject
    }
    property <int> tick: ModalState.focus-tick;
    changed tick => { if !ModalState.dialog-open { name.focus-field(); } }
    init => {
        name.focus-field();
        name.select-field();
    }

    Overlay {
        card-width: 320px;
        backdrop-clicked => { ModalState.name-cancel(); }
        VerticalLayout {
            spacing: 12px;
            Heading { text: ModalState.name-title; }
            name := Field {
                label: "Name";
                text <=> ModalState.name-text;
                edited(t) => { ModalState.name-field(t); }
                accepted => { ModalState.name-save(); }
            }
            if ModalState.name-colors: HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: start;
                    padding-top: 4px;
                    Caption { text: "Color"; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    // `.color-swatches` wraps; seven fit on a row here.
                    Rectangle {
                        height: (ModalState.swatches.length + 1 > 7 ? 2 : 1) * 32px - 8px;
                        for c[i] in ModalState.swatches: Rectangle {
                            x: mod(i, 7) * 32px;
                            y: floor(i / 7) * 32px;
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: c;
                            border-width: 2px;
                            border-color: ModalState.name-selected == i ? Theme.text : transparent;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { ModalState.name-pick(i); }
                            }
                        }
                        // The custom swatch: a colour wheel, or the custom colour once chosen.
                        Rectangle {
                            x: mod(ModalState.swatches.length, 7) * 32px;
                            y: floor(ModalState.swatches.length / 7) * 32px;
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: ModalState.name-selected < 0 ? ModalState.name-custom : @conic-gradient(#ff5b5b 0deg, #ffd75b 60deg, #5bffb0 120deg, #5bd6ff 180deg, #8a5bff 240deg, #ff5bd6 300deg, #ff5b5b 360deg);
                            border-width: 2px;
                            border-color: ModalState.name-selected < 0 ? Theme.text : transparent;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { ModalState.name-custom-clicked(); }
                            }
                        }
                    }
                    // Slint has no native colour picker: a hex field stands in for it.
                    if ModalState.name-hex-open: LineEdit {
                        placeholder-text: "#rrggbb";
                        text <=> ModalState.name-hex;
                        edited(t) => { ModalState.name-hex-edited(t); }
                        accepted => { ModalState.name-save(); }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                padding-top: 6px;
                Rectangle { horizontal-stretch: 1; }
                LpButton {
                    text: "Cancel";
                    clicked => { ModalState.name-cancel(); }
                }
                LpButton {
                    text: "Save";
                    primary: true;
                    clicked => { ModalState.name-save(); }
                }
            }
        }
    }
}

component MoveModal inherits FocusScope {
    key-pressed(e) => {
        if e.text == Key.Escape {
            ModalState.move-cancel();
            return accept;
        }
        reject
    }
    property <int> tick: ModalState.focus-tick;
    changed tick => { if !ModalState.dialog-open { self.focus(); } }
    init => { self.focus(); }

    Overlay {
        card-width: 320px;
        backdrop-clicked => { ModalState.move-cancel(); }
        VerticalLayout {
            spacing: 8px;
            Heading { text: "Move to Island"; }
            ScrollView {
                height: min(rows.preferred-height, 260px);
                content-height: rows.preferred-height;
                rows := VerticalLayout {
                    spacing: 4px;
                    for r[i] in ModalState.move-rows: Rectangle {
                        border-radius: 8px;
                        background: ta.has-hover && !r.current ? Theme.bg : transparent;
                        opacity: r.current ? 0.4 : 1;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            Text {
                                text: r.current ? r.label + " (current)" : r.label;
                                font-size: 13px;
                                color: Theme.text;
                                overflow: elide;
                            }
                        }
                        ta := TouchArea {
                            enabled: !r.current;
                            mouse-cursor: pointer;
                            clicked => { ModalState.move-pick(i); }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                padding-top: 6px;
                Rectangle { horizontal-stretch: 1; }
                LpButton {
                    text: "Cancel";
                    clicked => { ModalState.move-cancel(); }
                }
            }
        }
    }
}

component Dialog inherits FocusScope {
    key-pressed(e) => {
        if e.text == Key.Escape {
            ModalState.dialog-done(false);
            return accept;
        }
        if e.text == Key.Return {
            ModalState.dialog-done(true);
            return accept;
        }
        reject
    }
    property <int> tick: ModalState.focus-tick;
    changed tick => { self.focus(); }
    init => { self.focus(); }

    Overlay {
        card-width: 320px;
        backdrop-clicked => { ModalState.dialog-done(false); }
        VerticalLayout {
            spacing: 4px;
            // `.dialog-message`: pre-wrap, 14px, line-height 1.5.
            Text {
                text: ModalState.dialog-message;
                font-size: 14px;
                color: Theme.text;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                padding-top: 6px;
                Rectangle { horizontal-stretch: 1; }
                if ModalState.dialog-cancel: LpButton {
                    text: "Cancel";
                    clicked => { ModalState.dialog-done(false); }
                }
                LpButton {
                    text: ModalState.dialog-ok-label;
                    primary: !ModalState.dialog-danger;
                    danger-solid: ModalState.dialog-danger;
                    clicked => { ModalState.dialog-done(true); }
                }
            }
        }
    }
}

export component Modals inherits Rectangle {
    width: 100%;
    height: 100%;
    visible: ModalState.any-open;

    // The std widgets (text fields, selects, scroll bars) follow the theme.
    property <bool> light: Theme.light;
    init => { Palette.color-scheme = light ? ColorScheme.light : ColorScheme.dark; }
    changed light => { Palette.color-scheme = light ? ColorScheme.light : ColorScheme.dark; }

    if ModalState.app-open: AppModal { }
    if ModalState.name-open: NameModal { }
    if ModalState.move-open: MoveModal { }
    // Last, so on top: alerts and confirms come from the others and from Settings.
    if ModalState.dialog-open: Dialog { }
}
