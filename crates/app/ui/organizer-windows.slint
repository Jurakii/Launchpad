// The organizer's other windows (renderer/overlay.*, grid.*, scenes-menu.*,
// window-picker.* in 1.2). Rust side: src/ui/organizer/{drag,grid,menus}.rs.
// All rects arrive already worked out, in this window's logical pixels.
import { Theme } from "theme.slint";

export struct OverlayZone { layout-id: string, zone-id: string, x: length, y: length, w: length, h: length }
export struct OverlayLabel { layout-id: string, name: string, x: length, y: length, w: length }

// Over one display's work area while a window is dragged (the layout strip
// and the hovered zone's preview), or while a panel zone is hovered (the
// preview alone). Click-through; never focused.
export component OverlayWindow inherits Window {
    title: "Launchpad organizer overlay";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: Theme.font;

    in property <bool> has-strip;
    in property <length> strip-x;
    in property <length> strip-y;
    in property <length> strip-w;
    in property <length> strip-h;
    in property <[OverlayZone]> zones;
    in property <[OverlayLabel]> labels;
    in property <string> hovered-layout;
    in property <string> hovered-zone;
    in property <bool> has-preview;
    in property <length> preview-x;
    in property <length> preview-y;
    in property <length> preview-w;
    in property <length> preview-h;

    if has-preview: Rectangle {
        x: root.preview-x;
        y: root.preview-y;
        width: root.preview-w;
        height: root.preview-h;
        border-width: 2px;
        border-radius: 8px;
        border-color: Theme.accent;
        background: Theme.accent.with-alpha(0.22);
    }
    if has-strip: Rectangle {
        x: root.strip-x;
        y: root.strip-y;
        width: root.strip-w;
        height: root.strip-h;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: #00000059;
    }
    if has-strip: Rectangle {
        // Zones are drawn 2 px inside their hit rect: a visible line
        // between neighbours, no gap the cursor could fall into.
        for z in root.zones: Rectangle {
            x: z.x + 2px;
            y: z.y + 2px;
            width: max(0px, z.w - 4px);
            height: max(0px, z.h - 4px);
            border-radius: 3px;
            background: z.layout-id == root.hovered-layout && z.zone-id == root.hovered-zone
                ? Theme.accent : Theme.muted.mix(Theme.panel, 0.30);
        }
        for l in root.labels: Text {
            x: l.x;
            y: l.y;
            width: l.w;
            height: 16px;
            text: l.name;
            font-size: 11px;
            horizontal-alignment: center;
            color: l.layout-id == root.hovered-layout ? Theme.text : Theme.muted;
        }
    }
}

// The grid placer over one display's work area: pick a block of cells for
// the window being moved (drag, or click two corners; arrows move,
// Shift+arrows resize, Enter places, Esc cancels).
export component GridPlacerWindow inherits Window {
    title: "Launchpad organizer grid";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: Theme.font;

    in property <int> cols: 6;
    in property <int> rows: 4;
    in property <length> gap: 8px;
    in property <string> target-title;
    in property <image> target-icon;
    in-out property <int> bx;
    in-out property <int> by;
    in-out property <int> bw: 1;
    in-out property <int> bh: 1;
    in property <string> hint;
    in property <bool> hint-error;

    // (x, y) cells: a press, a drag to, a release; keys.
    callback cell-down(int, int);
    callback cell-move(int, int);
    callback cell-up(int, int);
    callback cancel;
    callback key(string, bool) -> bool;

    property <length> cw: (self.width - gap * (cols + 1)) / cols;
    property <length> ch: (self.height - gap * (rows + 1)) / rows;

    Rectangle { background: #00000059; }
    for i in cols * rows: Rectangle {
        x: gap + mod(i, cols) * (cw + gap);
        y: gap + floor(i / cols) * (ch + gap);
        width: cw;
        height: ch;
        border-radius: 6px;
        border-width: 1px;
        border-color: #ffffff73;
        background: ta.has-hover && cw > 0 && floor(ta.mouse-x / (cw + gap)) == mod(i, cols) && floor(ta.mouse-y / (ch + gap)) == floor(i / cols)
            ? Theme.accent.with-alpha(0.12) : transparent;
    }
    Rectangle {
        x: gap + root.bx * (cw + gap);
        y: gap + root.by * (ch + gap);
        width: root.bw * cw + (root.bw - 1) * gap;
        height: root.bh * ch + (root.bh - 1) * gap;
        border-width: 2px;
        border-radius: 8px;
        border-color: Theme.accent;
        background: Theme.accent.with-alpha(0.28);
    }
    ta := TouchArea {
        mouse-cursor: crosshair;
        function cell-x() -> int { return max(0, min(root.cols - 1, floor(self.mouse-x / root.width * root.cols))); }
        function cell-y() -> int { return max(0, min(root.rows - 1, floor(self.mouse-y / root.height * root.rows))); }
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { root.cell-down(cell-x(), cell-y()); }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up { root.cell-up(cell-x(), cell-y()); }
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up { root.cancel(); }
        }
        moved => { if self.pressed { root.cell-move(cell-x(), cell-y()); } }
    }
    // What's being moved, and how; out of the way of a selection along the top.
    info := Rectangle {
        x: (root.width - self.width) / 2;
        y: root.by == 0 ? root.height - self.height - 24px : 24px;
        width: min(lay.preferred-width, root.width * 0.6);
        height: lay.preferred-height;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 12px;
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: #00000059;
        lay := VerticalLayout {
            padding-top: 12px;
            padding-bottom: 12px;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                if root.target-icon.width > 0: Image { width: 20px; height: 20px; source: root.target-icon; }
                Text { text: root.target-title; font-size: 14px; font-weight: 600; color: Theme.text; overflow: elide; }
            }
            Text {
                text: root.bw + " × " + root.bh + " of " + root.cols + " × " + root.rows;
                font-size: 13px;
                color: Theme.text;
                horizontal-alignment: center;
            }
            Text {
                text: root.hint;
                font-size: 12px;
                color: root.hint-error ? Theme.danger : Theme.muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.cancel(); return accept; }
            // Named for Rust: Slint's arrow keys are private-use characters.
            return root.key(e.text == Key.Return || e.text == " " ? "enter"
                : e.text == Key.LeftArrow ? "left" : e.text == Key.RightArrow ? "right"
                : e.text == Key.UpArrow ? "up" : e.text == Key.DownArrow ? "down" : e.text,
                e.modifiers.shift) ? accept : reject;
        }
    }
    public function take-focus() { fs.focus(); }
}

export struct MenuRow { id: string, title: string, meta: string, tag: string, icon: image, has-icon: bool }

// A drop-down under a panel button: the window picker (rows are windows)
// and the scenes menu (rows are scenes, plus Save and Manage). Takes the
// keyboard; closes on Esc and when it loses the focus.
export component MenuWindow inherits Window {
    title: "Launchpad organizer menu";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: Theme.font;
    default-font-size: 13px;

    in property <string> heading;
    in property <[MenuRow]> rows;
    in property <string> empty-text;
    // The scenes menu's two fixed entries.
    in property <bool> scenes;
    in-out property <int> current: -1;
    // Worked out from what's shown, not the layout: `if` rows are only made
    // when drawn, too late for sizing the window before it shows.
    property <length> list-h: min(360px, rows.length * 32px);
    property <int> parts: (heading != "" ? 1 : 0) + 1 + (rows.length == 0 && empty-text != "" ? 1 : 0) + (scenes ? 3 : 0);
    property <length> body-h: 12px + (parts - 1) * 2px + (heading != "" ? 26px : 0) + list-h
        + (rows.length == 0 && empty-text != "" ? 40px : 0) + (scenes ? 61px : 0);
    out property <length> content-height: body-h + 16px;

    callback pick(string);
    callback save;
    callback manage;
    callback dismiss;

    property <int> total: rows.length + (scenes ? 2 : 0);
    // The keyboard's row stays in view.
    changed current => {
        if current >= 0 && current < rows.length {
            if current * 32px < -list.content-y { list.content-y = -current * 32px; }
            if (current + 1) * 32px > -list.content-y + list.height { list.content-y = list.height - (current + 1) * 32px; }
        }
    }

    card := Rectangle {
        x: 8px;
        y: 8px;
        width: root.width - 16px;
        height: root.body-h;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 10px;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000066;
        lay := VerticalLayout {
            padding: 6px;
            spacing: 2px;
            if root.heading != "": Text {
                text: root.heading;
                font-size: 12px;
                color: Theme.muted;
                overflow: elide;
                height: 26px;
                vertical-alignment: center;

            }
            list := Flickable {
                height: min(360px, root.rows.length * 32px);
                content-height: root.rows.length * 32px;
            for r[i] in root.rows: Rectangle {
                y: i * 32px;
                width: parent.width;
                height: 30px;
                border-radius: 6px;
                background: root.current == i || rt.has-hover ? Theme.text.with-alpha(0.08) : transparent;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    if r.has-icon: VerticalLayout { alignment: center; Image { width: 16px; height: 16px; source: r.icon; } }
                    Text { text: r.title; color: Theme.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                    if r.tag != "": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 16px;
                            width: tagtext.preferred-width + 10px;
                            border-radius: 8px;
                            background: Theme.accent.with-alpha(0.18);
                            tagtext := Text { text: r.tag; font-size: 10px; color: Theme.accent; }
                        }
                    }
                    if r.meta != "": Text { text: r.meta; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                }
                rt := TouchArea { clicked => { root.pick(r.id); } }
            }
            }
            if root.rows.length == 0 && root.empty-text != "": Text {
                text: root.empty-text;
                color: Theme.muted;
                wrap: word-wrap;
                height: 40px;
                vertical-alignment: center;

            }
            if root.scenes: Rectangle { height: 1px; background: Theme.border; }
            if root.scenes: Rectangle {
                height: 30px;
                border-radius: 6px;
                background: root.current == root.rows.length || st.has-hover ? Theme.text.with-alpha(0.08) : transparent;
                Text { x: 8px; text: "Save current arrangement"; color: Theme.text; }
                st := TouchArea { clicked => { root.save(); } }
            }
            if root.scenes: Rectangle {
                height: 30px;
                border-radius: 6px;
                background: root.current == root.rows.length + 1 || mt.has-hover ? Theme.text.with-alpha(0.08) : transparent;
                Text { x: 8px; text: "Manage scenes…"; color: Theme.text; }
                mt := TouchArea { clicked => { root.manage(); } }
            }
        }
    }
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.dismiss(); return accept; }
            if root.total == 0 { return reject; }
            if e.text == Key.DownArrow {
                root.current = root.current < 0 ? 0 : mod(root.current + 1, root.total);
                return accept;
            }
            if e.text == Key.UpArrow {
                root.current = root.current < 0 ? root.total - 1 : mod(root.current - 1 + root.total, root.total);
                return accept;
            }
            if (e.text == Key.Return || e.text == " ") && root.current >= 0 {
                if root.current < root.rows.length { root.pick(root.rows[root.current].id); }
                else if root.current == root.rows.length { root.save(); }
                else { root.manage(); }
                return accept;
            }
            reject
        }
    }
    public function take-focus() { fs.focus(); }
}
