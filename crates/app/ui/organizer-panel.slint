// The organizer panel: a 32 px bar along the top of one display (renderer/
// panel.* in 1.2). Every layout as a small thumbnail whose zones move the
// focused window, that window's icon and title, the grid placer and scenes
// buttons, and a clock. On the display Launchpad's main window is on it
// also carries the window's top bar (breadcrumb and buttons). Rust side:
// src/ui/organizer/panel.rs. The window never takes the foreground.
import { Theme } from "theme.slint";

export struct PanelZone { id: string, name: string, x: int, y: int, w: int, h: int }
export struct PanelLayout { id: string, name: string, cols: int, rows: int, zones: [PanelZone] }
export struct PanelCrumb { id: string, name: string }

component Glyph inherits Path {
    in property <string> d;
    in property <float> box: 24;
    viewbox-width: box;
    viewbox-height: box;
    commands: d;
}

component IconBtn inherits Rectangle {
    in property <string> d;
    in property <float> box: 24;
    in property <bool> stroke-only;
    in property <bool> idle;
    in property <color> tint: Theme.muted;
    callback clicked(/* x */ length, /* width */ length);
    width: 22px;
    height: 22px;
    border-radius: 4px;
    background: ta.has-hover && !idle ? Theme.text.with-alpha(0.10) : transparent;
    opacity: idle ? 0.45 : 1;
    Glyph {
        width: 16px;
        height: 16px;
        d: root.d;
        box: root.box;
        fill: stroke-only ? transparent : (ta.has-hover && !idle ? Theme.text : root.tint);
        stroke: stroke-only ? (ta.has-hover && !idle ? Theme.text : root.tint) : transparent;
        stroke-width: stroke-only ? 1.3px : 0;
    }
    ta := TouchArea {
        clicked => { root.clicked(root.absolute-position.x, root.width); }
    }
}

component TextBtn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked;
    height: 22px;
    width: label.preferred-width + 18px;
    border-radius: 5px;
    border-width: 1px;
    border-color: primary || ta.has-hover ? Theme.accent : Theme.border;
    background: primary ? Theme.accent : Theme.panel;
    label := Text {
        text: root.text;
        font-size: 12px;
        color: primary ? #fff : Theme.text;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// One layout's thumbnail: its zones on the layout's own grid, 2 px apart.
component Thumb inherits Rectangle {
    in property <PanelLayout> layout;
    in property <bool> pick; // nothing to move: outlined until hovered
    callback zone-clicked(string, string, length);
    callback zone-hover(string, string);
    callback zone-leave;
    height: 20px;
    border-radius: 4px;
    background: Theme.text.with-alpha(0.08);
    property <length> cw: (self.width - 4px - (layout.cols - 1) * 2px) / layout.cols;
    property <length> ch: (self.height - 4px - (layout.rows - 1) * 2px) / layout.rows;
    for z in layout.zones: Rectangle {
        x: 2px + z.x * (cw + 2px);
        y: 2px + z.y * (ch + 2px);
        width: z.w * cw + (z.w - 1) * 2px;
        height: z.h * ch + (z.h - 1) * 2px;
        border-radius: 2px;
        background: zt.has-hover ? Theme.accent : pick ? transparent : Theme.muted.mix(Theme.panel, 0.45);
        border-width: pick && !zt.has-hover ? 1px : 0;
        border-color: Theme.muted.mix(Theme.panel, 0.70);
        zt := TouchArea {
            changed has-hover => {
                if self.has-hover { root.zone-hover(root.layout.id, z.id); } else { root.zone-leave(); }
            }
            clicked => { root.zone-clicked(root.layout.id, z.id, root.absolute-position.x); }
        }
    }
}

export component PanelWindow inherits Window {
    title: "Launchpad organizer panel";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: Theme.font;
    default-font-size: 12px;

    in property <[PanelLayout]> layouts;
    // The display's work area width / height: thumbnails take its shape.
    in property <float> aspect: 16 / 9;
    in property <bool> has-focused;
    in property <string> focused-title;
    in property <image> focused-icon;
    // No window to move: zones and the grid button open the picker.
    in property <bool> pick;
    in property <string> message;
    in property <string> grid-tip: "Grid placer";
    in property <string> clock-date;
    in property <string> clock-time;
    // Launchpad's top bar, on the display its window is on.
    in property <bool> hosted;
    in property <[PanelCrumb]> crumbs;
    in property <bool> fullscreen;
    // The crumb an item dragged from the grid is over (-1: none).
    in property <int> drop-crumb: -1;
    // Physical height of the bar; the window can be taller (Windows' minimum).
    in property <length> bar-height: 32px;

    callback zone-clicked(string, string, length);
    callback zone-hover(string, string);
    callback zone-leave;
    callback grid-clicked(length);
    callback scenes-clicked(length, length);
    callback toolbar(string);
    callback crumb-clicked(string);
    callback crumb-menu(string, length, length);
    // Where each hosted crumb is (index, x, width), for drops from the grid.
    callback crumb-geom(int, length, length);

    property <string> style: Theme.topbar-style;
    property <bool> transparent-look: style == "transparent";

    bar := Rectangle {
        y: 0;
        height: root.bar-height;
        background: transparent-look ? transparent : style == "translucent" ? Theme.panel.with-alpha(0.72) : Theme.panel;
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: transparent-look ? transparent : Theme.border;
        }

        // Left: Launchpad's breadcrumb (hosted), then the layouts, clipped.
        left := HorizontalLayout {
            x: 12px;
            width: (root.width - middle.width) / 2 - 28px;
            alignment: start;
            spacing: 10px;
            if root.hosted: HorizontalLayout {
                spacing: 2px;
                padding-right: 10px;
                for c[i] in root.crumbs: HorizontalLayout {
                    spacing: 2px;
                    if i > 0: Text { text: "›"; color: Theme.border; vertical-alignment: center; }
                    Rectangle {
                        width: ct.preferred-width + 8px;
                        init => { root.crumb-geom(i, self.absolute-position.x, self.width); }
                        changed absolute-position => { root.crumb-geom(i, self.absolute-position.x, self.width); }
                        changed width => { root.crumb-geom(i, self.absolute-position.x, self.width); }
                        border-radius: 4px;
                        border-width: root.drop-crumb == i ? 2px : 0;
                        border-color: Theme.accent;
                        ct := Text {
                            text: c.name;
                            vertical-alignment: center;
                            font-weight: i == root.crumbs.length - 1 ? 600 : 400;
                            color: i == root.crumbs.length - 1 || cta.has-hover ? Theme.text : Theme.muted;
                        }
                        cta := TouchArea {
                            clicked => { root.crumb-clicked(c.id); }
                            pointer-event(e) => {
                                if e.button == PointerEventButton.right && e.kind == PointerEventKind.up && i == root.crumbs.length - 1 && c.id != "" {
                                    root.crumb-menu(c.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                    }
                }
                Rectangle { width: 1px; background: Theme.border; }
            }
            Rectangle {
                clip: true;
                horizontal-stretch: 1;
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    for l in root.layouts: VerticalLayout {
                        alignment: center;
                        Thumb {
                            width: round(20 * root.aspect) * 1px;
                            layout: l;
                            pick: root.pick;
                            zone-clicked(a, b, x) => { root.zone-clicked(a, b, x); }
                            zone-hover(a, b) => { root.zone-hover(a, b); }
                            zone-leave => { root.zone-leave(); }
                        }
                    }
                }
            }
        }

        // Centre: the focused window, or a message for a few seconds.
        middle := HorizontalLayout {
            x: (root.width - self.width) / 2;
            width: min(self.preferred-width, root.width * 0.4);
            spacing: 8px;
            if root.message == "" && root.has-focused && root.focused-icon.width > 0: VerticalLayout {
                alignment: center;
                Image { width: 16px; height: 16px; source: root.focused-icon; }
            }
            Text {
                vertical-alignment: center;
                overflow: elide;
                text: root.message != "" ? root.message
                    : root.has-focused ? root.focused-title
                    : root.pick ? "Click a zone to pick a window to put there" : "";
                color: root.message != "" || !root.has-focused ? Theme.muted : Theme.text;
            }
        }

        // Right: Launchpad's buttons (hosted), grid, scenes, clock.
        HorizontalLayout {
            x: root.width - self.width - 12px;
            width: self.preferred-width;
            spacing: 12px;
            if root.hosted: HorizontalLayout {
                spacing: 6px;
                padding-right: 12px;
                alignment: center;
                VerticalLayout { alignment: center; TextBtn { text: "Media"; clicked => { root.toolbar("media"); } } }
                VerticalLayout { alignment: center; TextBtn { text: "Layouts"; clicked => { root.toolbar("layouts"); } } }
                VerticalLayout {
                    alignment: center;
                    IconBtn {
                        tint: Theme.accent;
                        d: "M21.9,10.59,20,8.69V6a2,2,0,0,0-2-2H15.31l-1.9-1.9a2,2,0,0,0-2.82,0L8.69,4H6A2,2,0,0,0,4,6V8.69l-1.9,1.9a2,2,0,0,0,0,2.82L4,15.31V18a2,2,0,0,0,2,2H8.69l1.9,1.9a2,2,0,0,0,2.82,0l1.9-1.9H18a2,2,0,0,0,2-2V15.31l1.9-1.9A2,2,0,0,0,21.9,10.59ZM12,16a4,4,0,1,1,4-4A4,4,0,0,1,12,16Z";
                        clicked => { root.toolbar("settings"); }
                    }
                }
                if !Theme.hide-add-buttons: VerticalLayout { alignment: center; TextBtn { text: "+ New Island"; clicked => { root.toolbar("newIsland"); } } }
                if !Theme.hide-add-buttons: VerticalLayout { alignment: center; TextBtn { text: "+ Add App"; primary: true; clicked => { root.toolbar("addApp"); } } }
                VerticalLayout {
                    alignment: center;
                    IconBtn {
                        tint: Theme.accent;
                        d: root.fullscreen
                            ? "M9,3A1,1,0,0,0,8,4V6.59L3.71,2.29A1,1,0,0,0,2.29,3.71L6.59,8H4a1,1,0,0,0,0,2H8a2,2,0,0,0,2-2V4A1,1,0,0,0,9,3ZM16,10h4a1,1,0,0,0,0-2H17.41l4.3-4.29a1,1,0,1,0-1.42-1.42L16,6.59V4a1,1,0,0,0-2,0V8A2,2,0,0,0,16,10ZM8,14H4a1,1,0,0,0,0,2H6.59l-4.3,4.29a1,1,0,0,0,0,1.42,1,1,0,0,0,1.42,0L8,17.41V20a1,1,0,0,0,2,0V16A2,2,0,0,0,8,14ZM17.41,16H20a1,1,0,0,0,0-2H16a2,2,0,0,0-2,2v4a1,1,0,0,0,2,0V17.41l4.29,4.3a1,1,0,0,0,1.42,0,1,1,0,0,0,0-1.42Z"
                            : "M5.41,4H8A1,1,0,0,0,8,2H4A2,2,0,0,0,2,4V8A1,1,0,0,0,4,8V5.41l4.29,4.3a1,1,0,0,0,1.42,0,1,1,0,0,0,0-1.42ZM20,2H16a1,1,0,0,0,0,2h2.59l-4.3,4.29a1,1,0,0,0,0,1.42,1,1,0,0,0,1.42,0L20,5.41V8a1,1,0,0,0,2,0V4A2,2,0,0,0,20,2ZM8.29,14.29,4,18.59V16a1,1,0,0,0-2,0v4a2,2,0,0,0,2,2H8a1,1,0,0,0,0-2H5.41l4.3-4.29a1,1,0,0,0-1.42-1.42ZM21,15a1,1,0,0,0-1,1v2.59l-4.29-4.3a1,1,0,0,0-1.42,1.42L18.59,20H16a1,1,0,0,0,0,2h4a2,2,0,0,0,2-2V16A1,1,0,0,0,21,15Z";
                        clicked => { root.toolbar("fullscreen"); }
                    }
                }
                Rectangle { width: 1px; background: Theme.border; }
            }
            VerticalLayout {
                alignment: center;
                IconBtn {
                    box: 16;
                    stroke-only: true;
                    d: "M2 2h5v5H2zM9 2h5v5H9zM2 9h5v5H2zM9 9h5v5H9z";
                    clicked(x, w) => { root.grid-clicked(x); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconBtn {
                    box: 16;
                    stroke-only: true;
                    d: "M3.5 5h9a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 12.5v-6A1.5 1.5 0 0 1 3.5 5zM4 3h8M6 1.2h4";
                    clicked(x, w) => { root.scenes-clicked(x, w); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: root.clock-date; color: Theme.muted; vertical-alignment: center; }
                Text { text: root.clock-time; color: Theme.text; vertical-alignment: center; }
            }
        }
    }
}
