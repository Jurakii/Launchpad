{
  "name": "launchpad",
  "version": "1.0.0",
  "description": "Personal desktop-replacement launcher for apps that don't play nice with the taskbar/Start Menu",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/build.js"
  },
  "build": {
    "appId": "com.ncrouse.launchpad",
    "productName": "Launchpad",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "lib/*.ps1"
    ]
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  }
}
